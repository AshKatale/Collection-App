# PostgreSQL connection (Neon / local). Keep this file out of git; copy to .env
DATABASE_URL=postgresql://user:password@localhost:5432/collectors_db

# Required, at least 16 random characters (the server refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business day used for "today" (collectors can only add/change entries for today)
APP_TIMEZONE=Asia/Kolkata

# Shown on Excel / PDF reports
ORG_NAME=Siddhivinayak Mandal

# Used only by `npm run db:seed`
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=choose-a-strong-password
