generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  COLLECTOR
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum EntryType {
  SAVINGS
  LOAN
  INTEREST
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  phone      String?
  role       Role     @default(COLLECTOR)
  ownerId    String?
  owner      User?    @relation("OwnerCollectors", fields: [ownerId], references: [id])
  collectors User[]   @relation("OwnerCollectors")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customersOwned Customer[]          @relation("CustomerOwner")
  assignments    CollectorCustomer[]
  entriesCollected Entry[]           @relation("EntryCollector")
  entriesOwned   Entry[]             @relation("EntryOwner")
  entriesCreated Entry[]             @relation("EntryCreator")
  accessAsCollector AccessRequest[]  @relation("AccessCollector")
  accessAsOwner  AccessRequest[]     @relation("AccessOwner")
}

model Customer {
  id                 String              @id @default(cuid())
  accountNo          String
  name               String
  phone              String?
  address            String?
  // Usual amount collected per day (used for one-tap collection in the Collect screen)
  // (legacy single amount; kept so old data is not lost, used as Savings fallback)
  defaultDailyAmount Decimal?            @db.Decimal(12, 2)
  // Usual daily amount per type: pre-fills the Collect screen (doubled on Mondays)
  defaultSavings     Decimal?            @db.Decimal(12, 2)
  defaultLoan        Decimal?            @db.Decimal(12, 2)
  defaultInterest    Decimal?            @db.Decimal(12, 2)
  ownerId            String
  owner              User                @relation("CustomerOwner", fields: [ownerId], references: [id])
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  entries            Entry[]
  assignments        CollectorCustomer[]
  ledgerLoans        LedgerLoan[]
  ledgerDeposits     LedgerDeposit[]
  ledgerTerms        LedgerTerm[]
  ledgerOverrides    LedgerOverride[]
  ledgerOpening      LedgerOpening?
  ledgerSettlements  LedgerSettlement[]

  // Same account number may be shared by different people (joint/family accounts),
  // but the same number + same name inside one owner's book is a duplicate.
  @@unique([ownerId, accountNo, name])
  @@index([ownerId, accountNo])
}

model CollectorCustomer {
  collectorId String
  collector   User     @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@id([collectorId, customerId])
  @@index([customerId])
}

model Entry {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  collectorId String
  collector   User      @relation("EntryCollector", fields: [collectorId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  type        EntryType
  // Money is stored exactly (no floating point rounding)
  amount      Decimal   @db.Decimal(12, 2)
  notes       String?
  ownerId     String
  owner       User      @relation("EntryOwner", fields: [ownerId], references: [id])
  createdBy   String
  creator     User      @relation("EntryCreator", fields: [createdBy], references: [id])
  // Client generated id: makes retries / offline replays idempotent (no duplicates)
  clientId    String?   @unique
  // Soft delete: entries are never physically removed so history stays auditable
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date, collectorId])
  @@index([customerId, date])
  @@index([ownerId, date])
  @@index([deletedAt])
}

// Who changed which entry, and what it looked like before / after
model AuditLog {
  id        String   @id @default(cuid())
  entryId   String
  actorId   String
  actorName String
  action    String // CREATE | UPDATE | DELETE
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([createdAt])
}

// A collector may only add/change TODAY's entries. For any other date (past or
// future) the owner must approve a request (or grant access directly).
model AccessRequest {
  id            String       @id @default(cuid())
  collectorId   String
  collector     User         @relation("AccessCollector", fields: [collectorId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User         @relation("AccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  fromDate      DateTime     @db.Date
  toDate        DateTime     @db.Date
  reason        String?
  status        AccessStatus @default(PENDING)
  decidedBy     String?
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([collectorId, status])
  @@index([ownerId, status])
}

/* ───────────────────────── Customer ledger (web, Admin / Owner only) ─────────────────────────
   Only the *facts* are stored here (loans given, deposits, rates, manual interest, settlements).
   Monthly interest and balances are calculated from them and from the daily collections, so a
   corrected collection is reflected automatically. See src/services/ledgerEngine.js           */

enum LedgerKind {
  LOAN
  FD
  SAVINGS
}

enum LedgerRateMode {
  PERCENT // percent per month
  AMOUNT // fixed rupees per month
}

// What a SAVINGS (daily collection) percentage is applied on
enum LedgerBase {
  BALANCE // total collected so far
  MONTH // only that month's collection
}

model LedgerLoan {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  ownerId    String
  date       DateTime  @db.Date
  amount     Decimal   @db.Decimal(12, 2)
  notes      String?
  createdBy  String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([customerId])
}

// Fixed deposit
model LedgerDeposit {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  ownerId    String
  date       DateTime  @db.Date
  amount     Decimal   @db.Decimal(12, 2)
  notes      String?
  createdBy  String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([customerId])
}

// Interest terms set by the owner, effective from the month of `date`
model LedgerTerm {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  kind       LedgerKind
  targetId   String         @default("") // FD: the deposit id (or "OPENING"); otherwise empty
  sourceId   String? // the loan / deposit / "OPENING" this term was entered with
  date       DateTime       @db.Date
  mode       LedgerRateMode
  value      Decimal        @db.Decimal(14, 4)
  base       LedgerBase?
  createdBy  String
  createdAt  DateTime       @default(now())

  @@index([customerId])
}

// One month's interest typed in by the owner (replaces the calculated amount)
model LedgerOverride {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  kind       LedgerKind
  targetId   String     @default("")
  month      String // YYYY-MM
  amount     Decimal    @db.Decimal(14, 2)
  createdBy  String
  updatedAt  DateTime   @updatedAt

  @@unique([customerId, kind, targetId, month])
}

// Balances carried over from the paper book, as on the 1st of `month`
model LedgerOpening {
  customerId      String   @id
  customer        Customer @relation(fields: [customerId], references: [id])
  month           String // YYYY-MM
  loanPrincipal   Decimal  @default(0) @db.Decimal(14, 2)
  pendingInterest Decimal  @default(0) @db.Decimal(14, 2)
  fdAmount        Decimal  @default(0) @db.Decimal(14, 2)
  fdInterest      Decimal  @default(0) @db.Decimal(14, 2)
  savings         Decimal  @default(0) @db.Decimal(14, 2)
  savingsInterest Decimal  @default(0) @db.Decimal(14, 2)
  createdBy       String
  updatedAt       DateTime @updatedAt
}

// Account settled with the customer on `date`. Never deleted: cancelled ones stay in the history.
model LedgerSettlement {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  date            DateTime  @db.Date
  // Positive: paid to the customer. Negative: received from the customer.
  finalAmount     Decimal   @db.Decimal(14, 2)
  snapshot        Json
  notes           String?
  createdBy       String
  createdByName   String
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  cancelledByName String?

  @@index([customerId, date])
}

model LedgerAudit {
  id         String   @id @default(cuid())
  customerId String
  actorId    String
  actorName  String
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}
